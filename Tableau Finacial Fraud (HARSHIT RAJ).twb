    <worksheet name='Sheet 5'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Bold' fontsize='11'>InflationAdjustedTransactionAmount</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='cc_data (cc_data)' name='federated.0g9c2nf1n9kue616rqs4x1qdnqr1' />
          </datasources>
          <datasource-dependencies datasource='federated.0g9c2nf1n9kue616rqs4x1qdnqr1'>
            <column caption='Inflation-Adjusted Transaction Amounts' datatype='real' name='[Calculation_1190268449128448]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[amt] * (1 + 0.02) ^ (YEAR(TODAY()) - YEAR([trans_date_trans_time]))' />
            </column>
            <column caption='Amt' datatype='real' name='[amt]' role='measure' type='quantitative' />
