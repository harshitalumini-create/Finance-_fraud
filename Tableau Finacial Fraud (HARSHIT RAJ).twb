      <aliases enabled='yes' />
      <column caption='Fraud Status' datatype='string' name='[Calculation_0033307639697408]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [is_fraud] = 1 THEN &quot;Fraud&quot;&#13;&#10;ELSE &quot;Not Fraud&quot;&#13;&#10;END' />
      </column>
      <column caption='Inflation-Adjusted Transaction Amounts' datatype='real' name='[Calculation_1190268449128448]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[amt] * (1 + 0.02) ^ (YEAR(TODAY()) - YEAR([trans_date_trans_time]))' />
      </column>
